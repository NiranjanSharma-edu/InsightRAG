# ==============================================================================
# InsightRAG - Local Development Configuration
# ==============================================================================
# This file contains development-specific configuration overrides.
# It is safe to commit to version control as it contains no credentials or secrets.

# --- Network Configuration ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- File Watching / Hot Reload Polling ---
# Force polling for FastAPI uvicorn (watchfiles) inside Windows bind mounts
WATCHFILES_FORCE_POLLING=true

# Force polling for Next.js (webpack 5 watchpack) inside Windows bind mounts
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
