# ==============================================================================
# InsightRAG - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local usage and fill in your secrets.
# Do NOT commit `.env` or `.env.production` files containing real secrets to Git.

# --- Project Core ---
PROJECT_NAME=InsightRAG

# --- RAG Default Parameters ---
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_TOP_K=4
DEFAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2
DEFAULT_LLM_PROVIDER=mock

# --- Third-Party LLM Provider Keys (Optional) ---
# Paste your keys here to enable live LLM models via OpenAI, Groq, or Gemini
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
