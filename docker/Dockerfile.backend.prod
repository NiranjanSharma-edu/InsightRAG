# Stage 1: Build dependencies
FROM python:3.12-slim AS builder

WORKDIR /app

# Install system build dependencies (GCC, OpenMP, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .

# Use BuildKit cache mount to cache PyTorch CPU package
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install torch --index-url https://download.pytorch.org/whl/cpu

# Filter out testing libraries (pytest) for a production-only footprint
RUN grep -v "pytest" requirements.txt > requirements-prod.txt

# Use BuildKit cache mount to install other python dependencies
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --default-timeout=1000 -r requirements-prod.txt

# Stage 2: Final runner
FROM python:3.12-slim AS runner

# OCI Image Metadata
LABEL org.opencontainers.image.title="InsightRAG Backend" \
      org.opencontainers.image.description="InsightRAG Production API Backend Service" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.source="https://github.com/NiranjanSharma-edu/InsightRAG" \
      org.opencontainers.image.maintainer="Niranjan Sharma" \
      org.opencontainers.image.licenses="MIT"

WORKDIR /app

# Install runtime OpenMP support needed by FAISS and gosu for runtime permission handling
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root system user and group
RUN groupadd -g 10001 backend && \
    useradd -u 10001 -g backend -m -d /home/backend -s /bin/bash backend

# Pre-create directory paths and apply ownership to backend user
RUN mkdir -p /app/data /app/cache && \
    chown -R backend:backend /app/data /app/cache

# Copy pre-compiled dependencies and executables from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy app source code and adjust ownership
COPY --chown=backend:backend backend/ .

# Ensure the entrypoint script has Linux line endings and is executable
RUN sed -i 's/\r$//' docker-entrypoint.sh && \
    chmod +x docker-entrypoint.sh

# Direct Hugging Face model downloads to the persistent cache directory
ENV HF_HOME=/app/data/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/app/data/huggingface \
    PYTHONUNBUFFERED=1

# Container starts as root to configure volume permissions in the entrypoint,
# dropping privileges to the backend user before running uvicorn.
# Therefore, USER directive is commented out to run entrypoint as root.
# USER backend

ENTRYPOINT ["./docker-entrypoint.sh"]

EXPOSE 8000

# Docker healthcheck that queries the lightweight healthz endpoint dynamically
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen('http://localhost:' + os.environ.get('PORT', '8000') + '/healthz', timeout=5)"

# Start uvicorn dynamically binding to Railway assigned port (fallback to 8000)
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
